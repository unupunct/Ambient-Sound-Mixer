<Window x:Class="AmbientSoundMixer.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ambient Sound Mixer" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="22">
        <TextBlock x:Name="Prompt" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <TextBox x:Name="Input" MaxLength="80"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Padding="16,7"/>
            <Button Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}" Padding="20,7" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
