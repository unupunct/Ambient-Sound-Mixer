<Window x:Class="AmbientSoundMixer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AmbientSoundMixer.App.ViewModels"
        Title="Ambient Sound Mixer" Width="1120" Height="760" MinWidth="860" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        Icon="Assets/app.ico" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#33FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#59FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scenario card -->
        <DataTemplate DataType="{x:Type vm:ScenarioViewModel}">
            <Border Width="190" Height="200" Margin="0,0,12,14" CornerRadius="16" Background="{Binding Gradient}" BorderThickness="2" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding SelectCommand}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource EmojiFont}" FontSize="24" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Foreground="White" Opacity="0.9" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" Text="{Binding SoundsText}" Foreground="White" Opacity="0.7" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GlassButton}" Command="{Binding PlayCommand}" ToolTip="Play this scenario" AutomationProperties.Name="Play">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Play" Foreground="White" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlassButton}" Command="{Binding StopCommand}" Margin="6,0,0,0" ToolTip="Stop playback" AutomationProperties.Name="Stop">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stop" Foreground="White" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Mixer channel card -->
        <DataTemplate DataType="{x:Type vm:ChannelViewModel}">
            <Border Style="{StaticResource Card}" Width="340" Margin="0,0,14,14" Padding="16,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource EmojiFont}" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsRenaming, Converter={StaticResource InvBoolToVis}}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" FontSize="13"
                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                     IsVisibleChanged="RenameBox_IsVisibleChanged" LostFocus="RenameBox_LostFocus">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding EndRenameCommand}"/>
                                    <KeyBinding Key="Escape" Command="{Binding EndRenameCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="KindText"/>
                                        <Binding Path="StatusText"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                                <TextBlock.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Resources>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70F;" Command="{Binding RenameCommand}" ToolTip="Rename" AutomationProperties.Name="Rename"/>
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding RemoveCommand}" ToolTip="Remove from mixer (never deletes files)" AutomationProperties.Name="Remove"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="100" Value="{Binding VolumePercent}" AutomationProperties.Name="Volume"/>
                        <TextBlock Grid.Column="1" Text="{Binding VolumePercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- noise type -->
                    <Grid Margin="0,10,0,0" Visibility="{Binding IsNoise, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Noise type" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ChannelViewModel.NoiseTypes}" SelectedItem="{Binding SelectedNoise}"/>
                    </Grid>

                    <!-- binaural -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding IsBinaural, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Base" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="{Binding MinBase}" Maximum="{Binding MaxBase}" Value="{Binding BaseFrequency}" AutomationProperties.Name="Base frequency"/>
                            <TextBlock Grid.Column="2" Text="{Binding BaseFrequency, StringFormat={}{0:0} Hz}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Beat difference" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="{Binding MinBeat}" Maximum="{Binding MaxBeat}" Value="{Binding BeatFrequency}" AutomationProperties.Name="Beat frequency difference"/>
                            <TextBlock Grid.Column="2" Text="{Binding BeatFrequency, StringFormat={}{0:0.#} Hz}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Muted}">
                            <Run Text="Band: "/><Run Text="{Binding BandName, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{x:Static vm:ChannelViewModel.BandNames}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Padding="9,3" FontSize="12" Margin="0,0,6,6"
                                            Command="{Binding DataContext.SetBandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                   Text="Needs stereo headphones, one tone per ear. Keep the volume moderate. Bands are conventional labels; no effect is guaranteed."/>
                    </StackPanel>

                    <!-- imported file -->
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Text="{Binding FilePath}" ToolTip="{Binding FilePath}"
                               Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsMuted}" ToolTip="Mute / unmute" AutomationProperties.Name="Mute"/>
                        <CheckBox Grid.Column="2" Content="On" IsChecked="{Binding IsEnabled}" ToolTip="Enable or disable this sound" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top navigation -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E3A60" Offset="0"/>
                                <GradientStop Color="#4AA8D6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ambient Sound Mixer" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl Grid.Column="1" ItemsSource="{Binding Scenarios}" Margin="24,0,0,0" VerticalAlignment="Center"
                              Visibility="{Binding IsCompact, Converter={StaticResource InvBoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScenarioViewModel}">
                            <Button Content="{Binding Title}" Command="{Binding SelectCommand}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,2,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="Mixer" Command="{Binding ShowMixerCommand}" Margin="0,0,2,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMixerView}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Presets" Command="{Binding ShowPresetsCommand}" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPresetsView}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE706;" Command="{Binding ToggleThemeCommand}" ToolTip="Switch between dark and light theme" AutomationProperties.Name="Toggle theme"/>
                    <Button Command="{Binding ToggleCompactCommand}" ToolTip="Compact mode" AutomationProperties.Name="Compact mode" Content="&#xE73F;">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ToggleAlwaysOnTopCommand}" ToolTip="Keep window on top" AutomationProperties.Name="Always on top" Content="&#xE718;">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlwaysOnTop}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ShowSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings" Content="&#xE713;">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource LineBrush}" Margin="8,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Message banner -->
        <Border Grid.Row="1" Margin="20,12,20,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MessageIsWarning}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="26" Content="&#xE711;" Command="{Binding DismissMessageCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message"/>
            </Grid>
        </Border>

        <!-- Mixer view -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsMixerView, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="20,18,6,12">
                <ItemsControl ItemsSource="{Binding Scenarios}" Visibility="{Binding IsCompact, Converter={StaticResource InvBoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Transport -->
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,14,18">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding PlayPauseCommand}" Padding="18,9" AutomationProperties.Name="Play or pause">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PlayPauseGlyph}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentFgBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PlayPauseText}" Foreground="{DynamicResource AccentFgBrush}" Margin="8,0,0,0" MinWidth="44"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopCommand}" Margin="8,0,0,0" Padding="16,9" AutomationProperties.Name="Stop">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stop" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="70">
                                <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Engine state"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,0" Width="250" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Master" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MasterPercent}" AutomationProperties.Name="Master volume"/>
                                <TextBlock Grid.Column="2" Text="{Binding MasterPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource Meter}" Margin="0,8,0,0" Value="{Binding PeakPercent, Mode=OneWay}" Tag="{Binding IsNearClipping}" ToolTip="Output level (pre-limiter)"/>
                            <TextBlock Text="{Binding ClipText}" FontSize="11" Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNearClipping}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" Style="{StaticResource Muted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding SleepOptions}" SelectedItem="{Binding SelectedSleepMinutes}" ItemStringFormat="{}{0} min" Width="104"
                                      IsEnabled="{Binding IsSleepActive, Converter={StaticResource InvBool}}" AutomationProperties.Name="Sleep timer duration"/>
                            <Button Content="{Binding SleepButtonText}" Command="{Binding ToggleSleepCommand}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding SleepText}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- Mixer header -->
                <Grid Margin="0,0,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Mixer" Style="{StaticResource SectionTitle}" FontSize="18"/>
                        <TextBlock Text="Drop audio files anywhere in the window to import" Style="{StaticResource Muted}" Margin="14,3,0,0"
                                   Visibility="{Binding IsCompact, Converter={StaticResource InvBoolToVis}}"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button Command="{Binding AddNoiseCommand}" Margin="0,0,8,0" ToolTip="Add a white, pink or brown noise generator">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="Noise" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                        <Button Command="{Binding AddBinauralCommand}" Margin="0,0,8,0" ToolTip="Add a binaural beat generator (headphones required)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="Binaural beat" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                        <Button Command="{Binding ImportCommand}" ToolTip="Import WAV, MP3, FLAC and other audio files">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="Import audio…" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>

                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14" FontSize="13" TextWrapping="Wrap"
                           Text="The mixer is empty. Pick a scenario, or add a noise generator, binaural beat or audio file."
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Presets view -->
        <Grid Grid.Row="2" Margin="20,18,20,20" Visibility="{Binding IsPresetsView, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Your presets" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}">
                                        <Run Text="{Binding Channels.Count, Mode=OneWay}"/><Run Text=" sounds"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Save current mix" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"
                                   Text="Stores scenario, every channel's volume, mute and on/off state, noise types, binaural settings, imported file paths and master volume."/>
                        <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                        <Button Content="Save preset" Style="{StaticResource PrimaryButton}" Command="{Binding SavePresetCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Selected preset" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <Button Content="Load" Style="{StaticResource PrimaryButton}" Command="{Binding LoadPresetCommand}" HorizontalAlignment="Left"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Rename…" Command="{Binding RenamePresetCommand}" Margin="0,0,8,8"/>
                            <Button Content="Duplicate" Command="{Binding DuplicatePresetCommand}" Margin="0,0,8,8"/>
                            <Button Content="Delete…" Command="{Binding DeletePresetCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <Button Content="Restore default presets" Command="{Binding RestoreDefaultPresetsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Settings view -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="20,18,20,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,14"/>

                <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,14" DataContext="{Binding Settings}">
                    <StackPanel>
                        <TextBlock Text="Appearance and window" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Theme" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"/></Grid>
                        <CheckBox Content="Start with Windows (launches minimized)" IsChecked="{Binding StartWithWindows}" Margin="0,8"/>
                        <CheckBox Content="Minimize to the system tray" IsChecked="{Binding MinimizeToTray}" Margin="0,8"/>
                        <CheckBox Content="Close button hides to the tray (use the tray menu to exit)" IsChecked="{Binding CloseToTray}" Margin="0,8"/>
                        <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" Margin="0,8"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,14" DataContext="{Binding Settings}">
                    <StackPanel>
                        <TextBlock Text="Playback" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Default master volume" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DefaultMasterPercent}"/>
                            <TextBlock Grid.Column="2" Text="{Binding DefaultMasterPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Scenario crossfade" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="10" Value="{Binding CrossfadeSeconds}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CrossfadeSeconds, StringFormat={}{0:0.0} s}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Fade in on play" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="10" Value="{Binding FadeInSeconds}"/>
                            <TextBlock Grid.Column="2" Text="{Binding FadeInSeconds, StringFormat={}{0:0.0} s}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Fade out on pause / stop" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="10" Value="{Binding FadeOutSeconds}"/>
                            <TextBlock Grid.Column="2" Text="{Binding FadeOutSeconds, StringFormat={}{0:0.0} s}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        <CheckBox Content="Remember the last session (restored on launch, never auto-plays unless enabled below)" IsChecked="{Binding RememberLastSession}" Margin="0,8"/>
                        <CheckBox Content="Start playing automatically when the app launches" IsChecked="{Binding AutoPlayOnStart}" Margin="0,8"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Playback always stops and the audio device is released when the app exits."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,14" DataContext="{Binding Settings}">
                    <StackPanel>
                        <TextBlock Text="Audio output" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Output device" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice}"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshDevicesCommand}" ToolTip="Refresh device list" Margin="6,0,0,0"/></Grid>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Audio is routed to the selected device. With 'System default device' the app follows Windows when you change the default. If a device disappears, playback moves to the default device."/>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Buffer (latency)" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="30" Maximum="500" Value="{Binding LatencyMs}"/>
                            <TextBlock Grid.Column="2" Text="{Binding LatencyMs, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        <Button Content="Apply buffer size now" Command="{Binding ApplyLatencyCommand}" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Sample rate" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}" ItemStringFormat="{}{0} Hz"/></Grid>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding SampleRateNote}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,14" DataContext="{Binding Settings}">
                    <StackPanel>
                        <TextBlock Text="Sleep timer" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Default duration" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="5" Maximum="180" Value="{Binding SleepTimerMinutes}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SleepTimerMinutes, StringFormat={}{0:0} min}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        <CheckBox Content="Fade out gradually when the timer ends" IsChecked="{Binding SleepTimerFadeOut}" Margin="0,8"/>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Fade length" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="120" Value="{Binding SleepTimerFadeSeconds}" IsEnabled="{Binding SleepTimerFadeOut}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SleepTimerFadeSeconds, StringFormat={}{0:0} s}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,14" DataContext="{Binding Settings}">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <TextBlock Text="Ambient Sound Mixer" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" Margin="0,2,0,8"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                                   Text="Released under the MIT License. The MIT license covers this project's original code; third-party libraries (such as NAudio) keep their own licenses. All scenario ambience is generated in real time by the app, and no recordings are bundled. See THIRD-PARTY-NOTICES.md."/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="Binaural beats need stereo headphones. Frequency band names (Delta, Theta, Alpha, Beta, Gamma) are conventional labels only; this app makes no medical claims and no promise of any effect on sleep, focus or health. Keep the volume moderate."/>
                        <Button Content="Reset settings to defaults" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
